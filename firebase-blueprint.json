{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account and subscription status",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "packType": { "type": "string", "enum": ["free", "solo", "business", "agency"] },
        "bonusSites": { "type": "number" },
        "hasUnseenReward": { "type": "boolean" },
        "rewardMessage": { "type": "string" },
        "rewardType": { "type": "string", "enum": ["gift", "upgrade", "slots"] },
        "expirationDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "packType", "expirationDate"]
    },
    "Site": {
      "title": "WooCommerce Site",
      "description": "Connected WooCommerce store settings and cached data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "consumerKeyEnc": { "type": "string" },
        "consumerSecretEnc": { "type": "string" },
        "geminiApiKeyEnc": { "type": "string" },
        "niche": { "type": "string" },
        "country": { "type": "string" },
        "products": { "type": "array" },
        "posts": { "type": "array" },
        "lastSync": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "url", "consumerKeyEnc", "consumerSecretEnc"]
    },
    "Subscription": {
      "title": "Subscription Transaction",
      "description": "PayPal transaction and history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "paypalOrderId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "paypalOrderId", "status"]
    },
    "CompetitorData": {
      "title": "Competitor Analysis",
      "description": "Scraped SEO and keyword data",
      "type": "object",
      "properties": {
        "siteId": { "type": "string" },
        "competitorUrl": { "type": "string" },
        "keywords": { "type": "array" },
        "difficultyScore": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteId", "competitorUrl"]
    },
    "RegisteredSite": {
      "title": "Registered Site Log",
      "description": "Global log of registered URLs to prevent duplicates",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "ownerId"]
    },
    "SystemConfig": {
      "title": "System Configuration",
      "description": "Sensitive global settings like API keys",
      "type": "object",
      "properties": {
        "geminiApiKey": { "type": "string" }
      },
      "required": ["geminiApiKey"]
    }
  },
  "firestore": {
    "/settings/config": {
      "schema": "SystemConfig",
      "description": "Global application configuration"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and subscription info"
    },
    "/sites/{siteId}": {
      "schema": "Site",
      "description": "WooCommerce store credentials"
    },
    "/registered_sites/{registeredSiteId}": {
      "schema": "RegisteredSite",
      "description": "Global uniqueness index for sites"
    },
    "/subscriptions/{subId}": {
      "schema": "Subscription",
      "description": "Payment history"
    },
    "/competitors/{compId}": {
      "schema": "CompetitorData",
      "description": "Market intelligence data"
    }
  }
}
